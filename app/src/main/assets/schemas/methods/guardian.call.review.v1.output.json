{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.call.review.v1.output.json",
  "title": "ReviewCallOutput",
  "description": "Result of guardian.call.review@v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "rulesRisk",
    "rulesScore",
    "flags",
    "onDeviceQueued"
  ],
  "properties": {
    "eventId": {
      "type": "integer",
      "minimum": 1,
      "title": "Screening event"
    },
    "rulesRisk": {
      "type": "string",
      "enum": [
        "SAFE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Rules risk"
    },
    "rulesScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "title": "Rules score"
    },
    "flags": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 120
      },
      "title": "Rule flags"
    },
    "onDeviceQueued": {
      "type": "boolean",
      "title": "On-device review queued"
    }
  }
}
