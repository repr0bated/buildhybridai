{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.integration.set.v1.input.json",
  "title": "SetIntegrationInput",
  "description": "Turn an integration on or off. Stored on this phone only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integration",
    "enabled",
    "statusAtChange"
  ],
  "properties": {
    "integration": {
      "type": "string",
      "enum": [
        "phone_sms",
        "phone_calls",
        "google_voice",
        "whatsapp",
        "whatsapp_business",
        "jev"
      ],
      "title": "Integration",
      "readOnly": true
    },
    "enabled": {
      "type": "boolean",
      "title": "On"
    },
    "statusAtChange": {
      "type": "string",
      "maxLength": 160,
      "title": "Status when changed",
      "readOnly": true
    }
  }
}