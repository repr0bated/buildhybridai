{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.sms.unsubscribe.v1.output.json",
  "title": "UnsubscribeSmsOutput",
  "description": "Result of guardian.sms.unsubscribe@v1. One receipt lists every number that was texted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "recipients",
    "results",
    "keyword",
    "queued",
    "sentAt"
  ],
  "properties": {
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "title": "Service",
      "readOnly": true
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 20,
        "pattern": "^\\+?[0-9]{3,15}$",
        "format": "phone"
      },
      "title": "Numbers texted",
      "readOnly": true
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "title": "Per-number result",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recipient",
          "queued"
        ],
        "properties": {
          "recipient": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^\\+?[0-9]{3,15}$",
            "format": "phone",
            "title": "Number"
          },
          "queued": {
            "type": "boolean",
            "title": "Handed to the SMS app"
          }
        }
      }
    },
    "keyword": {
      "type": "string",
      "enum": [
        "STOP",
        "STOPALL",
        "UNSUBSCRIBE",
        "CANCEL",
        "END",
        "QUIT"
      ],
      "title": "Text sent"
    },
    "queued": {
      "type": "boolean",
      "title": "Every number was handed to the SMS app"
    },
    "sentAt": {
      "type": "integer",
      "minimum": 0,
      "format": "epoch-millis",
      "title": "Sent at"
    }
  }
}
