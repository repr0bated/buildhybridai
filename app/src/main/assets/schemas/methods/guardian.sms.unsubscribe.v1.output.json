{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.sms.unsubscribe.v1.output.json",
  "title": "UnsubscribeSmsOutput",
  "description": "Result of guardian.sms.unsubscribe@v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipient",
    "keyword",
    "queued",
    "sentAt"
  ],
  "properties": {
    "recipient": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20,
      "pattern": "^\\+?[0-9]{3,15}$",
      "format": "phone",
      "title": "Sent to"
    },
    "keyword": {
      "type": "string",
      "enum": [
        "STOP",
        "STOPALL",
        "UNSUBSCRIBE",
        "CANCEL",
        "END",
        "QUIT"
      ],
      "title": "Text sent"
    },
    "queued": {
      "type": "boolean",
      "title": "Handed to the SMS app"
    },
    "sentAt": {
      "type": "integer",
      "minimum": 0,
      "format": "epoch-millis",
      "title": "Sent at"
    }
  }
}
