{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/subscription_check.schema.json",
  "title": "SubscriptionCheck",
  "description": "On-device (Gemini Nano 4) confirmation of a subscription sender and its unsubscribe link.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "isSubscription",
    "unsubscribeLink"
  ],
  "properties": {
    "isSubscription": {
      "type": "boolean"
    },
    "unsubscribeLink": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    }
  }
}