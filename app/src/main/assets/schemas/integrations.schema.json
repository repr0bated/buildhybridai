{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/integrations.schema.json",
  "title": "Integrations",
  "description": "Every source of content Call Guardian can screen, plus the Jev second opinion. Settings \u2192 Integrations, the notification listener and the Lab tabs are all generated from integrations.json. To add an app, add an entry (and its id to the enums).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "integrations"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Integration"
      }
    }
  },
  "definitions": {
    "Integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "description",
        "defaultEnabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "phone_sms",
            "phone_calls",
            "google_voice",
            "whatsapp",
            "whatsapp_business",
            "jev"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "phone_sms",
            "phone_calls",
            "notification_listener",
            "cloud_function"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "sms",
            "google_voice",
            "whatsapp",
            "call_screening",
            "call_log",
            "lab_sample"
          ],
          "description": "message_source.schema.json value for content from this integration."
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^android\\.permission\\.[A-Z_]+$"
          }
        },
        "defaultEnabled": {
          "type": "boolean"
        },
        "optOut": {
          "type": "string",
          "enum": [
            "text_stop",
            "reply_in_app",
            "block_or_report_in_app"
          ],
          "description": "How to stop a subscription from this source. Call Guardian only ever texts from the phone's own SMS (text_stop)."
        },
        "optOutHint": {
          "type": "string",
          "maxLength": 120
        },
        "chatDeepLink": {
          "type": "string",
          "maxLength": 120,
          "description": "URI template with {number} that opens the chat in that app."
        },
        "ignoreTextPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "description": "Regexes for summary notifications to skip (e.g. '3 new messages')."
        }
      }
    }
  }
}